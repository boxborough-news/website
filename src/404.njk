---
layout: layouts/base.njk
permalink: /404.html
title: Page not found
noindex: true
---
<div class="narrow">
  <header class="section-head">
    <h1>Page not found</h1>
    <p>Sorry, we couldn't find that page. It may have moved when we launched our new website.</p>
  </header>
  <form class="search-inline" action="/search/" role="search">
    <label for="nf-q" class="visually-hidden">Search Boxborough News</label>
    <input id="nf-q" name="q" type="search" placeholder="Search all articles">
    <button class="button" type="submit">Search</button>
  </form>
  <p><a href="/">Go to the home page</a> or <a href="/archive/">browse the archive</a>.</p>
  {%- if site.old_site_url %}<p>Articles from 2023 to 2026 are on <a href="{{ site.old_site_url }}">our previous website</a>.</p>{% endif %}
</div>
{%- if site.old_site_url %}
<script>
  // Old-site addresses such as /archives/jan-jun-2026-news live on the previous website.
  (function () {
    var old = {{ (site.old_site_url | replace(r/\/$/, "")) | dump | safe }};
    var p = location.pathname.replace(/\/$/, "");
    if (/^\/archives\//.test(p)) location.replace(old + p + location.hash);
  })();
</script>
{%- endif %}
