---
layout: layouts/base.njk
---
<div class="page-wrap{% if show_staff %} has-aside{% endif %}">
  <article class="article page-article" data-pagefind-body>
    <span hidden data-pagefind-meta="image:-"></span>
    <header class="article-head">
      <h1 class="article-title">{{ title }}</h1>
      {%- if subtitle %}<p class="deck">{{ subtitle }}</p>{% endif %}
    </header>
    <div class="prose">
      {{ content | safe }}
    </div>
  </article>
  {%- if show_staff %}
  <aside class="box staff-box" aria-label="Boxborough News staff">
    <h2 class="label">Who we are</h2>
    {%- if staff.statement %}<p class="staff-statement">{{ staff.statement }}</p>{% endif %}
    <dl>
      {%- if staff.editors_in_chief %}
      <dt>Editors-in-Chief</dt>
      <dd>{{ staff.editors_in_chief }}</dd>
      {%- endif %}
      {%- if staff.contributors %}
      <dt>Contributors</dt>
      <dd>{{ staff.contributors }}</dd>
      {%- endif %}
      <dt>Contact</dt>
      <dd>{% if staff.contact_email %}<a href="mailto:{{ staff.contact_email }}">{{ staff.contact_email }}</a> or {% endif %}<a href="/contact/">our contact page</a></dd>
      {%- if site.print_partner_url %}
      <dt>In print</dt>
      <dd>Selected articles and headlines appear in <em>Action Unlimited – Acton/Boxborough Edition</em>. <a href="{{ site.print_partner_url }}">Read the latest edition →</a></dd>
      {%- endif %}
    </dl>
  </aside>
  {%- endif %}
</div>
