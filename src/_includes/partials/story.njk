{#- A story teaser. Set: item, size ("lead" | "medium" | "small"), showImage, showSection, teaserWords -#}
{%- set d = item.data %}
<article class="story story-{{ size or 'medium' }}{% if showImage and d.image %} has-image{% endif %}">
  {%- if showImage and d.image %}
  <a class="story-image{% if d.image_fit == 'full' %} is-full{% endif %}" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
    {%- if size == 'lead' %}
    <img src="{{ d.image }}" alt="{{ d.image_alt }}" sizes="(min-width: 1000px) 760px, 100vw" loading="eager" fetchpriority="high">
    {%- else %}
    <img src="{{ d.image }}" alt="{{ d.image_alt }}" sizes="(min-width: 1000px) 380px, 100vw">
    {%- endif %}
  </a>
  {%- endif %}
  <div class="story-text">
    {%- if showSection %}
    <p class="kicker">{{ (d.section | sectionInfo(sections)).name }}</p>
    {%- endif %}
    <h3 class="story-title"><a href="{{ item.url }}">{{ d.title | smart }}</a></h3>
    {%- if size == 'lead' %}<p class="story-teaser">{{ d.teaser }}</p>
    {%- elif size != 'small' %}<p class="story-teaser">{{ d.teaser | sentences(teaserWords or 28) }}</p>{% endif %}
    <p class="meta"><time datetime="{{ d.date | ymd }}">{{ d.date | date }}</time>{% if d.byline %} · {{ d.byline }}{% endif %}</p>
  </div>
</article>
