{#- A story teaser. Set: item, size ("lead" | "medium" | "small"), showImage, hideFlyer, showSection, teaserMin, teaserWords, hideDate, isNew.
    hideFlyer: no picture when it's a flyer, chart or logo (image_fit: full), as on the home page.
    Without an editor's summary, the teaser is the story's opening, so it ends with "…" to show it continues. -#}
{%- set d = item.data %}
{%- set pic = showImage and d.image and not (hideFlyer and d.image_fit == 'full') %}
<article class="story story-{{ size or 'medium' }}{% if pic %} has-image{% if d.image_fit == 'full' %} has-full-image{% endif %}{% else %} no-image{% endif %}">
  {%- if pic %}
  <a class="story-image{% if d.image_fit == 'full' %} is-full{% endif %}{% if d.image_focus and d.image_focus != 'center' %} focus-{{ d.image_focus }}{% endif %}" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
    {%- if size == 'lead' %}
    <img src="{{ d.image }}" alt="{{ d.image_alt }}" sizes="(min-width: 1000px) 760px, 100vw" loading="eager" fetchpriority="high">
    {%- else %}
    <img src="{{ d.image }}" alt="{{ d.image_alt }}" sizes="(min-width: 1000px) 380px, 100vw">
    {%- endif %}
  </a>
  {%- endif %}
  <div class="story-text">
    {%- if showSection or isNew %}
    <p class="kicker">{% if showSection %}{{ (d.section | sectionInfo(sections)).name }}{% endif %}{% if isNew %}{% if showSection %} · {% endif %}<span class="new-tag">New</span>{% endif %}</p>
    {%- endif %}
    <h3 class="story-title"><a href="{{ item.url }}">{{ d.title | smart }}</a></h3>
    {%- set isExcerpt = not (d.summary and (d.summary | trim)) %}
    {#- Cards aim at about the same preview length (teaserMin–teaserWords words), so a row of stories lines up. #}
    {#- Text-only cards get a little more of the story (about 45–65 words), so they don't look thin. #}
    {%- set t = d.teaser if size == 'lead' else ((d.opening or d.teaser) | preview(((teaserMin or 30) + 15) if not pic else (teaserMin or 30), ((teaserWords or 45) + 20) if not pic else (teaserWords or 45))) %}
    {%- if isExcerpt %}{% set t = t | continued %}{% endif %}
    {%- if size != 'small' %}<p class="story-teaser">{{ t }}</p>{% endif %}
    {%- if not hideDate or d.byline %}
    <p class="meta">{% if not hideDate %}<time datetime="{{ d.date | ymd }}">{{ d.date | date }}</time>{% endif %}{% if d.byline %}{% if not hideDate %} · {% endif %}{{ d.byline }}{% endif %}</p>
    {%- endif %}
  </div>
</article>
