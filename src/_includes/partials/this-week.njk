{#- Home page rail: the coming week's events (Boxborough first), then town meetings. -#}
{%- set ev = collections.eventsThisWeek %}
<section class="this-week" aria-labelledby="this-week-head">
  <div class="label-row">
    <h2 class="label" id="this-week-head"><a href="/events/">This week</a></h2>
    <a class="label-more" href="/events/">All events →</a>
  </div>
  {%- if ev.boxborough.length %}
  <h3 class="rail-sub">In Boxborough</h3>
  <ul class="event-list rail-list">{% for r in ev.boxborough %}{% include "partials/rail-row.njk" %}{% endfor %}</ul>
  {%- endif %}
  {%- if ev.nearby.length %}
  <h3 class="rail-sub">Nearby</h3>
  <ul class="event-list rail-list">{% for r in ev.nearby %}{% include "partials/rail-row.njk" %}{% endfor %}</ul>
  {%- endif %}
  {%- if not ev.boxborough.length and not ev.nearby.length %}
  <p class="small">No community events are listed for the coming week.</p>
  {%- endif %}
  <p class="more"><a class="more-secondary" href="/submit/">Submit an event</a></p>
  {%- set tmDays = 7 %}{% set tmMax = 6 %}
  {% include "partials/town-meetings.njk" %}
</section>
