{#- Home page rail: community events in the next seven days, then town meetings. -#}
{%- set rows = collections.eventsThisWeek %}
<section class="this-week" aria-labelledby="this-week-head">
  <h2 class="label" id="this-week-head"><a href="/events/">This week in Boxborough</a></h2>
  {%- if rows.length %}
  <ul class="event-list">
    {%- for r in rows %}{% include "partials/event-row.njk" %}{% endfor %}
  </ul>
  {%- else %}
  <p class="small">No community events are listed for the coming week.</p>
  {%- endif %}
  <p class="more"><a href="/events/">All events →</a> <a class="more-secondary" href="/submit/">Submit an event</a></p>
  {%- set tmDays = 7 %}{% set tmMax = 6 %}
  {% include "partials/town-meetings.njk" %}
</section>
