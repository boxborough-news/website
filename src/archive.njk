---
layout: layouts/base.njk
pagination:
  data: collections.archiveYears
  size: 1
  alias: yr
permalink: "{{ yr.url }}"
eleventyComputed:
  title: "{{ 'Archive' if yr.latest else 'Archive: ' + yr.year }}"
---
<div class="narrow">
  <header class="section-head">
    <h1>Archive{% if not yr.latest %}: {{ yr.year }}{% endif %}</h1>
    <p>Every article and community notice since 2023, by weekly issue. Past events are listed on <a href="/events/past/">their own page</a>.</p>
  </header>
  <form class="search-inline" action="/search/" role="search">
    <label for="archive-q" class="visually-hidden">Search Boxborough News</label>
    <input id="archive-q" name="q" type="search" placeholder="Search all articles">
    <button class="button" type="submit">Search</button>
  </form>
  <nav class="year-nav" aria-label="Archive years">
    {%- for y in yr.all %}
    <a href="{{ y.url }}"{% if y.year == yr.year %} aria-current="page"{% endif %}>{{ y.year }}</a>
    {%- endfor %}
  </nav>
  <div class="filters" role="group" aria-label="Show">
    <button type="button" data-filter="all" aria-pressed="true">All</button>
    <button type="button" data-filter="news" aria-pressed="false">News</button>
    <button type="button" data-filter="features" aria-pressed="false">Features</button>
    <button type="button" data-filter="announcements" aria-pressed="false">Notices</button>
  </div>
  <div class="archive">
    {%- for m in yr.issues %}
    <section class="archive-month" id="issue-{{ m.key }}">
      <h2>Issue of {{ m.label }} <span class="count">{{ m.items.length }}</span></h2>
      <ul>
        {%- for item in m.items %}
        <li data-sec="{{ item.data.section }}"><a href="{{ item.url }}">{{ item.data.title | smart }}</a> <span class="archive-sec">{{ "Notice" if item.data.section == "announcements" else (item.data.section | sectionInfo(sections)).name }}</span></li>
        {%- endfor %}
      </ul>
    </section>
    {%- endfor %}
  </div>
</div>
<script>
  (function () {
    var buttons = document.querySelectorAll(".filters button");
    buttons.forEach(function (b) {
      b.addEventListener("click", function () {
        var f = b.getAttribute("data-filter");
        buttons.forEach(function (x) { x.setAttribute("aria-pressed", x === b ? "true" : "false"); });
        document.querySelectorAll(".archive-month").forEach(function (m) {
          var n = 0;
          m.querySelectorAll("li").forEach(function (li) { var ok = f === "all" || li.getAttribute("data-sec") === f; li.hidden = !ok; if (ok) n++; });
          m.hidden = n === 0;
          m.querySelector(".count").textContent = n;
        });
      });
    });
  })();
</script>
