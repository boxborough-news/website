---
pagination:
  data: redirects
  size: 1
  alias: r
permalink: "{{ r.from }}"
eleventyExcludeFromCollections: true
noindex: true
---
{#- Small forwarding pages for addresses used by the old website (and the old /announcements/ list). -#}
{%- set target = r.to | url %}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="robots" content="noindex">
  <title>Redirecting…</title>
  <link rel="canonical" href="{{ target if target.startsWith('http') else (target | absolute) }}">
  <script>
    if (/^#h\./.test(location.hash)) {
      {% set fallback = target %}{% include "partials/old-links-script.njk" %}
    } else location.replace({{ target | dump | safe }});
  </script>
  <noscript><meta http-equiv="refresh" content="0; url={{ target }}"></noscript>
</head>
<body><p>This page has moved. <a href="{{ target }}">Continue</a>.</p></body>
</html>
