---
layout: layouts/base.njk
permalink: /search/
title: Search
---
<div class="narrow">
  <header class="section-head">
    <h1>Search</h1>
    <p>Search every article, event and notice on Boxborough News.{% if site.old_site_url %} Articles from 2023 to 2026 are on <a href="{{ site.old_site_url }}">our previous website</a>.{% endif %}</p>
  </header>
  <link href="/pagefind/pagefind-ui.css" rel="stylesheet">
  <div id="search" class="search-ui"></div>
  <noscript><p>Search needs JavaScript turned on. You can also <a href="/archive/">browse the archive</a>.</p></noscript>
</div>
<script src="/pagefind/pagefind-ui.js"></script>
<script>
  window.addEventListener("DOMContentLoaded", function () {
    var ui = new PagefindUI({ element: "#search", showSubResults: false, showImages: false, resetStyles: false, autofocus: true, showEmptyFilters: false });
    var q = new URLSearchParams(location.search).get("q");
    if (q) ui.triggerSearch(q);
  });
</script>
