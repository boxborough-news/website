---
layout: layouts/base.njk
permalink: /search/
title: Search
---
<div class="narrow">
  <header class="section-head">
    <h1>Search</h1>
    <p>Search every article, event and notice on Boxborough News, from 2023 to today. Narrow the results by section or year.</p>
  </header>
  <link href="/pagefind/pagefind-ui.css" rel="stylesheet">
  <div class="search-controls">
    <div class="filters" role="group" aria-label="Show results from">
      <button type="button" data-section="" aria-pressed="true">All</button>
      <button type="button" data-section="News" aria-pressed="false">News</button>
      <button type="button" data-section="Features" aria-pressed="false">Features</button>
      <button type="button" data-section="Events" aria-pressed="false">Events</button>
      <button type="button" data-section="Community notices" aria-pressed="false">Notices</button>
    </div>
    <div class="search-selects">
    <label class="sort-choice">Year
      <select id="search-year">
        <option value="">Any year</option>
        {%- for y in collections.archiveYears[0].all %}
        <option value="{{ y.year }}">{{ y.year }}</option>
        {%- endfor %}
      </select>
    </label>
    <label class="sort-choice">Sort by
      <select id="search-sort">
        <option value="relevance">Best match</option>
        <option value="newest">Newest first</option>
      </select>
    </label>
    </div>
  </div>
  <div id="search" class="search-ui"></div>
  <div class="search-none" id="search-none" hidden>
    <p class="search-none-head">No results for “<span></span>”</p>
    <ul>
      <li>Check the spelling, or try fewer or shorter words (for example, “Steele” instead of “Steele Farm barn restoration”).</li>
      <li>Choose <strong>All</strong> and <strong>Any year</strong> to search everything.</li>
      <li>Or <a href="/archive/">browse the archive</a> by year and issue.</li>
    </ul>
  </div>
  <noscript><p>Search needs JavaScript turned on. You can also <a href="/archive/">browse the archive</a>.</p></noscript>
</div>
<script src="/pagefind/pagefind-ui.js"></script>
<script>
  window.addEventListener("DOMContentLoaded", function () {
    var box = document.getElementById("search");
    var sortSel = document.getElementById("search-sort");
    var yearSel = document.getElementById("search-year");
    var buttons = document.querySelectorAll(".search-controls .filters button");
    var params = new URLSearchParams(location.search);
    var state = {
      q: params.get("q") || "",
      section: params.get("section") || "",
      year: /^\d{4}$/.test(params.get("year") || "") ? params.get("year") : "",
      sort: params.get("sort") === "newest" ? "newest" : "relevance",
    };
    var ui = null;

    // Our buttons and menus drive Pagefind's own (hidden) filter checkboxes.
    function applyFilter(name, value) {
      var boxes = box.querySelectorAll('.pagefind-ui__filter-checkbox[name="' + name + '"]');
      if (!boxes.length) return false;
      boxes.forEach(function (cb) {
        var want = cb.value === value;
        if (cb.checked !== want) cb.click();
      });
      return true;
    }
    function applyAll() {
      var a = !state.section || applyFilter("section", state.section);
      var b = !state.year || applyFilter("year", state.year);
      return a && b;
    }
    var observer = new MutationObserver(function () {
      tidyResults();
      if (pending && applyAll()) pending = false;
      noResults();
    });

    // "No results" help. Pagefind also counts a page as a match when a query merely starts with
    // a very short word on it (a search for "qwerty" matches the "Q:" in an interview), so when
    // every match is like that, we treat the search as having no results.
    var none = document.getElementById("search-none");
    function showNone(term) {
      none.querySelector("span").textContent = term;
      none.hidden = false;
      box.classList.add("is-empty");
    }
    function hideNone() { none.hidden = true; box.classList.remove("is-empty"); }
    function noResults() {
      var msg = box.querySelector(".pagefind-ui__message");
      if (msg && /^No results/.test(msg.textContent.trim())) showNone(((box.querySelector(".pagefind-ui__search-input") || {}).value || state.q || "").trim());
    }
    var pf = null, checkTimer = null, checkId = 0;
    function norm(w) { return String(w).toLowerCase().replace(/[^a-z0-9]/g, ""); }
    function checkWeak(term) {
      var id = ++checkId;
      var words = term.split(/\s+/).map(norm).filter(Boolean);
      if (!words.length) { hideNone(); return; }
      var shortest = Math.min.apply(null, words.map(function (w) { return w.length; }));
      (pf ? Promise.resolve(pf) : import({{ "/pagefind/pagefind.js" | url | dump | safe }}).then(function (m) { pf = m; return m; }))
        .then(function (pf) {
          var filters = {};
          if (state.section) filters.section = state.section;
          if (state.year) filters.year = state.year;
          return pf.search(term, { filters: filters });
        })
        .then(function (res) {
          if (id !== checkId || !res) return;
          if (!res.results.length) return;
          if (res.results.length > 40) { hideNone(); return; }
          return Promise.all(res.results.map(function (r) { return r.data().then(function (d) { return { r: r, d: d }; }); })).then(function (all) {
            if (id !== checkId) return;
            var toks = function (d) { return d.content.split(/\s+/); };
            var real = all.some(function (x) {
              if (!x.r.words.length) return false;
              var t = toks(x.d);
              return x.r.words.some(function (i) { return norm(t[i] || "").length * 2 >= shortest; });
            });
            real ? hideNone() : showNone(term);
          });
        })
        .catch(function () {});
    }
    box.addEventListener("input", function (e) {
      if (!e.target.classList.contains("pagefind-ui__search-input")) return;
      hideNone();
      clearTimeout(checkTimer);
      var term = e.target.value.trim();
      state.q = term;
      syncControls();
      if (term) checkTimer = setTimeout(function () { checkWeak(term); }, 350);
    });
    var pending = false;

    // Show each result's date and section as one plain line under the headline:
    // "Oct. 9, 2024 · News"
    function tidyResults() {
      box.querySelectorAll(".pagefind-ui__result-tags:not([data-tidy])").forEach(function (ul) {
        ul.setAttribute("data-tidy", "");
        var parts = [];
        ["date", "section"].forEach(function (k) {
          var li = ul.querySelector('[data-pagefind-ui-meta="' + k + '"]');
          if (li) parts.push(li.textContent.replace(/^[^:]*:\s*/, "").trim());
        });
        var line = document.createElement("p");
        line.className = "search-meta";
        line.textContent = parts.join(" · ");
        var title = ul.parentNode.querySelector(".pagefind-ui__result-title");
        if (title) title.insertAdjacentElement("afterend", line);
        ul.style.display = "none";
      });
    }

    function syncControls() {
      buttons.forEach(function (b) { b.setAttribute("aria-pressed", b.getAttribute("data-section") === state.section ? "true" : "false"); });
      sortSel.value = state.sort;
      yearSel.value = state.year;
      var url = new URL(location.href);
      ["q", "section", "year"].forEach(function (k) { state[k] ? url.searchParams.set(k, state[k]) : url.searchParams.delete(k); });
      state.sort === "newest" ? url.searchParams.set("sort", "newest") : url.searchParams.delete("sort");
      history.replaceState(null, "", url);
    }

    function readInput() {
      var input = box.querySelector(".pagefind-ui__search-input");
      if (input) state.q = input.value;
    }

    function build() {
      readInput();
      if (ui && ui._pfs) ui._pfs.$destroy();
      box.innerHTML = "";
      var opts = { element: "#search", showSubResults: false, showImages: false, resetStyles: false, autofocus: true };
      if (state.sort === "newest") opts.sort = { date: "desc" };
      ui = new PagefindUI(opts);
      hideNone();
      if (state.q) { ui.triggerSearch(state.q); checkWeak(state.q); }
      pending = !!(state.section || state.year);
      observer.disconnect();
      observer.observe(box, { childList: true, subtree: true });
      syncControls();
    }
    function refilter() {
      readInput();
      hideNone();
      if (state.q) setTimeout(function () { checkWeak(state.q); }, 50);
      if (!state.section) box.querySelectorAll('.pagefind-ui__filter-checkbox[name="section"]:checked').forEach(function (cb) { cb.click(); });
      if (!state.year) box.querySelectorAll('.pagefind-ui__filter-checkbox[name="year"]:checked').forEach(function (cb) { cb.click(); });
      pending = !applyAll();
      syncControls();
    }
    buttons.forEach(function (b) {
      b.addEventListener("click", function () { state.section = b.getAttribute("data-section"); refilter(); });
    });
    yearSel.addEventListener("change", function () { state.year = yearSel.value; refilter(); });
    sortSel.addEventListener("change", function () { state.sort = sortSel.value; build(); });
    build();
  });
</script>
