---
layout: layouts/base.njk
pagination:
  data: collections.sectionPages
  size: 1
  alias: sp
permalink: "{{ sp.url }}"
eleventyComputed:
  title: "{{ sp.section.name }}"
  oldPath: "{{ '/' + sp.section.key if sp.number == 1 else '' }}"
---
<header class="section-head">
  <h1>{{ sp.section.name }}</h1>
  <p>{{ sp.section.blurb }}</p>
</header>

<div class="section-grid">
  <div class="section-main">
    <div class="river">
      {%- set lastIssue = "" %}
      {%- for item in sp.items %}
      {%- set iss = item.data.date | issueOf %}
      {%- if iss != lastIssue %}
      <h2 class="issue-head" id="issue-{{ iss }}">{{ iss | date("long") }} issue</h2>
      {%- set lastIssue = iss %}
      {%- endif %}
      {%- set size = "medium" %}{% set showImage = true %}{% set showSection = false %}{% set teaserWords = 40 %}{% set hideDate = true %}
      {% include "partials/story.njk" %}
      {%- else %}
      <p>Nothing here yet.</p>
      {%- endfor %}
    </div>

    {%- if sp.prev or sp.next %}
    <nav class="pager" aria-label="More stories">
      {%- if sp.prev %}<a href="{{ sp.prev }}">← Newer</a>{% else %}<span></span>{% endif %}
      <span>Page {{ sp.number }} of {{ sp.total }}</span>
      {%- if sp.next %}<a href="{{ sp.next }}">Older →</a>{% else %}<span></span>{% endif %}
    </nav>
    {%- endif %}
  </div>
  <aside class="section-side">
    {% include "partials/this-week.njk" %}
  </aside>
</div>
