---
layout: layouts/base.njk
pagination:
  data: collections.sectionPages
  size: 1
  alias: sp
permalink: "{{ sp.url }}"
eleventyComputed:
  title: "{{ sp.section.name }}"
  oldPath: "{{ '/' + sp.section.key if sp.number == 1 else '' }}"
---
<div class="narrow">
  <header class="section-head">
    <h1>{{ sp.section.name }}</h1>
    <p>{{ sp.section.blurb }}</p>
  </header>

  <div class="river">
    {%- for item in sp.items %}
    {%- set size = "medium" %}{% set showImage = true %}{% set showSection = false %}{% set teaserWords = 40 %}
    {% include "partials/story.njk" %}
    {%- else %}
    <p>Nothing here yet.</p>
    {%- endfor %}
  </div>

  {%- if sp.prev or sp.next %}
  <nav class="pager" aria-label="More stories">
    {%- if sp.prev %}<a href="{{ sp.prev }}">← Newer</a>{% else %}<span></span>{% endif %}
    <span>Page {{ sp.number }} of {{ sp.total }}</span>
    {%- if sp.next %}<a href="{{ sp.next }}">Older →</a>{% else %}<span></span>{% endif %}
  </nav>
  {%- endif %}
  {%- if site.old_site_url and not sp.next %}
  <p class="small old-site-note">Looking for older stories? Articles from 2023 to 2026 are on <a href="{{ site.old_site_url }}">our previous website</a>.</p>
  {%- endif %}
</div>
